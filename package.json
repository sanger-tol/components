{
  "name": "@tol/tol-ui",
  "version": "0.0.5",
  "description": "An npm components package for ToL systems",
  "dependencies": {
    "node-sass": "^4.14.1",
    "@types/node": "^12.0.0",
    "react": "^17.0.1",
    "react-bootstrap": "^1.6.6",
    "react-dom": "^17.0.1",
    "react-router-dom": "^5.2.0",
    "@types/react-router-dom": "^5.1.7",
    "typescript": "^4.0.3",
    "axios": "^0.21.1"
  },
  "scripts": {
    "compile:sass": "node-sass scss/tol-styling.scss css/tol-styling.css",
    "build": "yarn build:esm && yarn build:cjs",
    "build:esm": "tsc",
    "build:cjs": "tsc --module commonjs --outDir lib/cjs"
  },
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/esm/index.d.ts",
  "repository": "git@gitlab.internal.sanger.ac.uk:tol/platforms/tol-ui.git",
  "keywords": [
    "gitlab",
    "package",
    "npm",
    "registry",
    "node"
  ],
  "author": "tol",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
