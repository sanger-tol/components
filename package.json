{
  "name": "@tol/tol-ui",
  "version": "0.0.1",
  "description": "An npm components package for ToL systems",
  "dependencies": {
    "react-bootstrap": "^1.4.3",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "typescript": "^4.0.3"
  },
  "scripts": {
    "build": "yarn build:esm && yarn build:cjs",
    "build:esm": "tsc",
    "build:cjs": "tsc --module commonjs --outDir lib/cjs"
  },
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/esm/index.d.ts",
  "repository": "git@gitlab.internal.sanger.ac.uk:tol/platforms/tol-ui.git",
  "keywords": [
    "gitlab",
    "package",
    "npm",
    "registry",
    "node"
  ],
  "author": "tol",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
