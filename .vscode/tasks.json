{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Playwright test (.env.dev)",
        "type": "shell",
        "command": "export $(grep -E '^(POSTGRES_USER|POSTGRES_PASSWORD|POSTGRES_DB|POSTGRES_HOST|POSTGRES_PORT)=' ../../.env.dev | sed 's/\"/\\\\\"/g') && npx playwright test",
        "options": {
          "cwd": "${workspaceFolder}/test/playwright"
        },
        "problemMatcher": []
      }
    ]
  }
  